#!/bin/sh
#
# Entware-backed web service for mihomo4asus.

ADDON_DIR="${ADDON_DIR:-/jffs/addons/mihomo}"
WEB_ROOT="${WEB_ROOT:-$ADDON_DIR/webui/www}"
WEB_CONF="${WEB_CONF:-$ADDON_DIR/webui/server.conf}"
WEB_PORT="${MIHOMO_WEB_PORT:-5581}"
MERLIN_ASSET_DIR="${MERLIN_ASSET_DIR:-/www/user/mihomo}"
MIHOMO_HOME="${MIHOMO_HOME:-/opt/root/mihomo}"
RUN_DIR="${RUN_DIR:-$MIHOMO_HOME/run}"
STATE_DIR="${STATE_DIR:-$MIHOMO_HOME/state}"
PID_FILE="${PID_FILE:-$RUN_DIR/mihomo-web.pid}"
PAGE_FILE="$STATE_DIR/webui.page"
SS_SCRIPT="${SS_SCRIPT:-/jffs/scripts/services-start}"
TAG="mihomo-web"
RAW_BASE="${RAW_BASE:-https://raw.githubusercontent.com/IKitKatt/mihomo4asus/web}"

log() {
    printf '%s\n' "$1" | logger -t mihomo-web
    printf '%s\n' "$1"
}

die() {
    log "ERROR: $1"
    exit 1
}

lighttpd_bin() {
    for path in /opt/sbin/lighttpd /opt/bin/lighttpd; do
        [ -x "$path" ] && { printf '%s\n' "$path"; return 0; }
    done
    command -v lighttpd 2>/dev/null && return 0
    return 1
}

opkg_bin() {
    for path in /opt/bin/opkg /opt/sbin/opkg; do
        [ -x "$path" ] && { printf '%s\n' "$path"; return 0; }
    done
    command -v opkg 2>/dev/null && return 0
    return 1
}

ensure_lighttpd() {
    opkg_path="$(opkg_bin)" || die "Entware opkg is required to install lighttpd"
    need_lighttpd=0
    need_cgi=0
    lighttpd_bin >/dev/null 2>&1 || need_lighttpd=1
    [ -f /opt/lib/lighttpd/mod_cgi.so ] || need_cgi=1

    [ "$need_lighttpd" -eq 0 ] && [ "$need_cgi" -eq 0 ] && return 0

    "$opkg_path" update || die "Entware package index update failed"
    if [ "$need_lighttpd" -eq 1 ]; then
        log "Installing Entware lighttpd package"
        "$opkg_path" install lighttpd || die "Entware could not install lighttpd"
    fi
    if [ "$need_cgi" -eq 1 ]; then
        log "Installing Entware lighttpd CGI module"
        "$opkg_path" install lighttpd-mod-cgi || die "Entware could not install the lighttpd CGI module"
    fi
    lighttpd_bin >/dev/null 2>&1 || die "lighttpd is required after package installation"
    [ -f /opt/lib/lighttpd/mod_cgi.so ] || die "lighttpd CGI module is required after package installation"
}

download_to_file() {
    url="$1"
    dst="$2"
    if [ -x /opt/bin/curl ] && /opt/bin/curl -fL --retry 2 --retry-delay 1 --connect-timeout 10 --max-time 120 -o "$dst" "$url"; then
        return 0
    fi
    wget -q -O "$dst" "$url" 2>/dev/null || \
        curl -fsSL -o "$dst" "$url" 2>/dev/null
}

ensure_dirs() {
    [ -d /opt ] || die "Entware /opt is not available"
    mkdir -p "$WEB_ROOT/cgi-bin" "$RUN_DIR" "$STATE_DIR" /jffs/scripts || die "cannot create web directories"
}

is_running() {
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    ensure_dirs
    # Merlin page registration is independent of the Entware HTTP service.
    mount_webui
    is_running && { log "mihomo web is already running on port $WEB_PORT"; return 0; }
    export PATH="/opt/bin:/opt/sbin:$PATH"
    ensure_lighttpd
    lighttpd_bin="$(lighttpd_bin)" || die "lighttpd is required; install it with Entware opkg"
    [ -f "$WEB_ROOT/index.html" ] || die "missing $WEB_ROOT/index.html"
    [ -f "$WEB_CONF" ] || die "missing $WEB_CONF"
    "$lighttpd_bin" -f "$WEB_CONF" || die "mihomo web failed to start"
    sleep 1
    is_running || die "mihomo web failed to start"
    install_hook
    log "mihomo web started on port $WEB_PORT"
}

stop_service() {
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    case "$pid" in
        ''|*[!0-9]*) ;;
        *) kill "$pid" 2>/dev/null ;;
    esac
    rm -f "$PID_FILE"
    log "mihomo web stopped"
}

install_hook() {
    [ -f "$SS_SCRIPT" ] || { echo "#!/bin/sh" > "$SS_SCRIPT"; chmod 755 "$SS_SCRIPT"; }
    line="(sleep 20 && $ADDON_DIR/webui/mihomo-web start) & # $TAG"
    grep -qF "$line" "$SS_SCRIPT" 2>/dev/null || echo "$line" >> "$SS_SCRIPT"
}

remove_hook() {
    [ -f "$SS_SCRIPT" ] && sed -i "/$TAG/d" "$SS_SCRIPT"
}

mount_webui() {
    [ -f /usr/sbin/helper.sh ] || return 0
    # shellcheck disable=SC1091
    . /usr/sbin/helper.sh
    nvram get rc_support 2>/dev/null | grep -q am_addons || return 0
    [ -f "$ADDON_DIR/Mihomo.asp" ] || return 0

    find_webui_page
    [ "$am_webui_page" != "none" ] || die "cannot allocate Merlin webui page"
    ln -s -f "$ADDON_DIR/Mihomo.asp" "/www/user/$am_webui_page" || die "cannot mount webui page"
    echo "mihomo" > "/www/user/${am_webui_page%.asp}.title" || die "cannot create Merlin page title"
    echo "$am_webui_page" > "$PAGE_FILE"

    mkdir -p "$MERLIN_ASSET_DIR" || die "cannot create Merlin asset directory"
    ln -s -f "$WEB_ROOT/app.js" "$MERLIN_ASSET_DIR/app.js" || die "cannot publish Mihomo application script"
    ln -s -f "$WEB_ROOT/app.css" "$MERLIN_ASSET_DIR/app.css" || die "cannot publish Mihomo application stylesheet"

    if [ ! -f /tmp/menuTree.js ]; then
        cp /www/require/modules/menuTree.js /tmp/menuTree.js || die "cannot copy Merlin menu"
        mount -o bind /tmp/menuTree.js /www/require/modules/menuTree.js || die "cannot mount Merlin menu"
    fi

    tmp_menu="/tmp/menuTree.mihomo.$$"
    grep -v 'tabName: "Mihomo"' /tmp/menuTree.js > "$tmp_menu" || die "cannot clean Merlin menu"
    mv "$tmp_menu" /tmp/menuTree.js || die "cannot update Merlin menu"
    sed '/index: "menu_VPN"/,/index:/ {
        /url:[[:space:]]*"NULL",[[:space:]]*tabName:[[:space:]]*"__INHERIT__"/ i \
    { url: "'"$am_webui_page"'", tabName: "Mihomo" },
    }' /tmp/menuTree.js > "$tmp_menu" || die "cannot add Mihomo VPN tab"
    mv "$tmp_menu" /tmp/menuTree.js || die "cannot update Merlin VPN menu"
    umount /www/require/modules/menuTree.js 2>/dev/null
    mount -o bind /tmp/menuTree.js /www/require/modules/menuTree.js || die "cannot remount Merlin menu"
}

find_webui_page() {
    am_webui_page="none"
    used_pages=""

    for page in /www/user/user*.asp; do
        [ -f "$page" ] || continue
        if grep -q 'page:mihomo' "$page"; then
            am_webui_page="${page##*/}"
            return 0
        fi
        page_number="${page##*/user}"
        page_number="${page_number%.asp}"
        case "$page_number" in
            ''|*[!0-9]*) continue ;;
        esac
        used_pages="$used_pages $page_number"
    done

    page_number=1
    while [ "$page_number" -le 20 ]; do
        echo "$used_pages" | grep -qw "$page_number" || {
            am_webui_page="user$page_number.asp"
            return 0
        }
        page_number=$((page_number + 1))
    done
}

unmount_webui() {
    find_webui_page
    page="$am_webui_page"
    [ -n "$page" ] && [ "$page" != "none" ] && rm -f "/www/user/$page"
    [ -n "$page" ] && [ "$page" != "none" ] && rm -f "/www/user/${page%.asp}.title"
    rm -rf "$MERLIN_ASSET_DIR"
    rm -f "$PAGE_FILE"
    if [ -f /tmp/menuTree.js ]; then
        sed -i '/tabName: "Mihomo"/d' /tmp/menuTree.js
        umount /www/require/modules/menuTree.js 2>/dev/null
        mount -o bind /tmp/menuTree.js /www/require/modules/menuTree.js 2>/dev/null
    fi
}

update_files() {
    ensure_dirs
    while read -r src dst; do
        [ -n "$src" ] || continue
        mkdir -p "$(dirname "$ADDON_DIR/$dst")"
        download_to_file "$RAW_BASE/$src" "$ADDON_DIR/$dst" || die "cannot download $src"
    done <<'EOF'
src/cli/mihomo mihomo
src/backend/_globals.sh src/backend/_globals.sh
src/backend/core.sh src/backend/core.sh
src/backend/subscription.sh src/backend/subscription.sh
src/backend/routing.sh src/backend/routing.sh
src/backend/service.sh src/backend/service.sh
src/backend/install.sh src/backend/install.sh
src/backend/cli.sh src/backend/cli.sh
src/backend/main.sh src/backend/main.sh
src/frontend/mihomo-web webui/mihomo-web
src/frontend/server.conf webui/server.conf
src/frontend/Mihomo.asp webui/Mihomo.asp
src/frontend/www/index.html webui/www/index.html
src/frontend/www/app.css webui/www/app.css
src/frontend/www/app.js webui/www/app.js
src/frontend/www/cgi-bin/api webui/www/cgi-bin/api
EOF
    cp "$ADDON_DIR/webui/Mihomo.asp" "$ADDON_DIR/Mihomo.asp" || die "cannot stage Merlin page"
    chmod 755 "$ADDON_DIR/mihomo" "$ADDON_DIR/webui/mihomo-web" "$WEB_ROOT/cgi-bin/api"
    chmod 644 "$ADDON_DIR"/src/backend/*.sh
    chmod 644 "$ADDON_DIR/webui/server.conf"
    chmod 644 "$ADDON_DIR/webui/Mihomo.asp" "$WEB_ROOT/index.html" "$WEB_ROOT/app.css" "$WEB_ROOT/app.js"
    chmod 644 "$ADDON_DIR/Mihomo.asp"
    log "mihomo web files updated"
}

status_service() {
    if is_running; then
        log "mihomo web: running on port $WEB_PORT"
    else
        log "mihomo web: stopped"
    fi
}

case "$1" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; sleep 1; start_service ;;
    status) status_service ;;
    mount) ensure_dirs; mount_webui ;;
    unmount) unmount_webui ;;
    update) update_files; stop_service; sleep 1; start_service ;;
    uninstall) stop_service; remove_hook; unmount_webui; rm -rf "$ADDON_DIR/webui" "$ADDON_DIR/Mihomo.asp" ;;
    *) printf 'Usage: %s {start|stop|restart|status|mount|unmount|update|uninstall}\n' "$0"; exit 1 ;;
esac
